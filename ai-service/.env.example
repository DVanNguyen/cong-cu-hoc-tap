# StudyAI AI Microservice (.env.example)
# Sao chép tệp này thành .env và điền khóa API của bạn trước khi chạy.

# 1. Cấu hình LLM tổng hợp ghi chú 3 tầng (gemini | openai | ollama | mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-2.5-flash
LLM_CACHE_ENABLED=true

# 2. Hugging Face Token (đã chấp nhận điều khoản pyannote/speaker-diarization-3.1)
HF_TOKEN=

# 3. Mô hình Nhận dạng giọng nói & Nhúng ngữ nghĩa đa ngôn ngữ
WHISPER_MODEL=medium
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto

# 4. Kết nối nội bộ với Laravel Backend
LARAVEL_API_URL=http://127.0.0.1:8000/api/v1
LARAVEL_WEBHOOK_SECRET=studyai_secret_token_2026
QDRANT_MODE=memory
TIMEZONE=Asia/Ho_Chi_Minh
